    <content type="html">
                &lt;div&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/dotnet/machinelearning/releases/tag/v6.0.0-preview1"&gt;v6.0.0-preview1&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h1&gt;&lt;a href="http://dot.net/ml" rel="nofollow"&gt;ML.NET&lt;/a&gt; 6.0.0-preview1&lt;/h1&gt;
&lt;h2&gt;&lt;strong&gt;New Features&lt;/strong&gt;&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Support gpt-5.1 model in Tiktoken tokenizer&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7556" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7556/hovercard"&gt;#7556&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Support Gpt-5.2 in Tokenizer library&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7571" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7571/hovercard"&gt;#7571&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Add gpt-5.3 model support to TiktokenTokenizer&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7579" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7579/hovercard"&gt;#7579&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;&lt;strong&gt;Enhancements&lt;/strong&gt;&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Remove Google.Protobuf dependency from Microsoft.ML.Tokenizers&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7587" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7587/hovercard"&gt;#7587&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Add heap-based BPE merge path for large inputs (&amp;gt;128 bytes)&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7580" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7580/hovercard"&gt;#7580&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;&lt;strong&gt;Bug Fixes&lt;/strong&gt;&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Fix bug that causes Merge to fail with empty DataFrames&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7573" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7573/hovercard"&gt;#7573&lt;/a&gt;) - Thanks &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/sevenzees/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/sevenzees"&gt;@sevenzees&lt;/a&gt;!&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Fix bug in PACKAGE.md examples&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7561" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7561/hovercard"&gt;#7561&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Fix local build on linux that was omitting arch argument&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7549" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7549/hovercard"&gt;#7549&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;&lt;strong&gt;Build / Test updates&lt;/strong&gt;&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Update MajorVersion to 6&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7543" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7543/hovercard"&gt;#7543&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Update mac build machines&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7558" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7558/hovercard"&gt;#7558&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Add .azuredevops/dependabot.yml&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7553" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7553/hovercard"&gt;#7553&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Add repo health check workflows (orchestrator, investigator, groomer) and known baseline&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7583" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7583/hovercard"&gt;#7583&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Add targets for repo health aw&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7588" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7588/hovercard"&gt;#7588&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;[main] Update dependencies from dotnet/arcade&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7540" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7540/hovercard"&gt;#7540&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;[main] Update dependencies from dotnet/arcade&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7559" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7559/hovercard"&gt;#7559&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;[main] Update dependencies from dotnet/arcade&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7562" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7562/hovercard"&gt;#7562&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;[main] Update dependencies from dotnet/arcade&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7563" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7563/hovercard"&gt;#7563&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;&lt;strong&gt;Documentation Updates&lt;/strong&gt;&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Add 5.0.0 release notes&lt;/strong&gt; (&lt;a href="https://github.com/dotnet/machinelearning/pull/7544" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/machinelearning/pull/7544/hovercard"&gt;#7544&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
