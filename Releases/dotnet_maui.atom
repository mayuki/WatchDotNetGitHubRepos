&lt;/ul&gt;
&lt;h2&gt;SwipeView&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;
&lt;p&gt;[release/10.0.1xx-sr10] Align Android SwipeItem content by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/kubaflo/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/kubaflo"&gt;@kubaflo&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="5218443885" data-permission-text="Title is private" data-url="https://github.com/dotnet/maui/issues/37727" data-hovercard-type="pull_request" data-hovercard-url="/dotnet/maui/pull/37727/hovercard" href="https://github.com/dotnet/maui/pull/37727"&gt;#37727&lt;/a&gt;&lt;/p&gt;
