    <content type="html">
                &lt;div&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/releases/tag/OpAmp.Client-0.4.0-alpha.1"&gt;OpAmp.Client-0.4.0-alpha.1&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;ul&gt;
&lt;li&gt;
&lt;p&gt;NuGet: &lt;a href="https://www.nuget.org/packages/OpenTelemetry.OpAmp.Client/0.4.0-alpha.1" rel="nofollow"&gt;OpenTelemetry.OpAmp.Client v0.4.0-alpha.1&lt;/a&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
&lt;p&gt;Bumped OpAMP spec to v0.18.0.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4421" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4421/hovercard"&gt;#4421&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;Fixed System.Net.Http package version resolution issues for .NET 4.6.2.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4402" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4402/hovercard"&gt;#4402&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;Add support for multivalue identification attributes.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4350" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4350/hovercard"&gt;#4350&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;Change default OpAMP port from &lt;code&gt;4318&lt;/code&gt; to &lt;code&gt;4320&lt;/code&gt;.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4374" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4374/hovercard"&gt;#4374&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;See &lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/blob/OpAmp.Client-0.4.0-alpha.1/src/OpenTelemetry.OpAmp.Client/CHANGELOG.md"&gt;CHANGELOG&lt;/a&gt; for details.&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
                            &lt;/div&gt;
                        &lt;/article&gt;
                    
