                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/releases/tag/PersistentStorage-1.1.0"&gt;PersistentStorage-1.1.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;ul&gt;
&lt;li&gt;
&lt;p&gt;NuGet: &lt;a href="https://www.nuget.org/packages/OpenTelemetry.PersistentStorage.Abstractions/1.1.0" rel="nofollow"&gt;OpenTelemetry.PersistentStorage.Abstractions v1.1.0&lt;/a&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
&lt;p&gt;Add &lt;code&gt;net8.0&lt;/code&gt; and &lt;code&gt;net10.0&lt;/code&gt; target frameworks.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4128" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4128/hovercard"&gt;#4128&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;Add support for &lt;code&gt;ReadOnlySpan&amp;lt;byte&amp;gt;&lt;/code&gt; as buffers.&lt;br&gt;
Obsoletes &lt;code&gt;byte[]&lt;/code&gt; buffers in the API.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4128" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4128/hovercard"&gt;#4128&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;See &lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/blob/PersistentStorage-1.1.0/src/OpenTelemetry.PersistentStorage.Abstractions/CHANGELOG.md"&gt;CHANGELOG&lt;/a&gt; for details.&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;NuGet: &lt;a href="https://www.nuget.org/packages/OpenTelemetry.PersistentStorage.FileSystem/1.1.0" rel="nofollow"&gt;OpenTelemetry.PersistentStorage.FileSystem v1.1.0&lt;/a&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
&lt;p&gt;Add &lt;code&gt;net8.0&lt;/code&gt; and &lt;code&gt;net10.0&lt;/code&gt; target frameworks.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4128" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4128/hovercard"&gt;#4128&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;Add support for &lt;code&gt;ReadOnlySpan&amp;lt;byte&amp;gt;&lt;/code&gt; as buffers.&lt;br&gt;
Obsoletes &lt;code&gt;byte[]&lt;/code&gt; buffers in the API.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4128" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4128/hovercard"&gt;#4128&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;See &lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/blob/PersistentStorage-1.1.0/src/OpenTelemetry.PersistentStorage.FileSystem/CHANGELOG.md"&gt;CHANGELOG&lt;/a&gt; for details.&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
