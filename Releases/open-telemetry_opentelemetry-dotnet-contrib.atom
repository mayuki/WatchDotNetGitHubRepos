    <content type="html">
                &lt;div&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/releases/tag/OpAmp.Client-0.5.0-alpha.1"&gt;OpAmp.Client-0.5.0-alpha.1&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;ul&gt;
&lt;li&gt;
&lt;p&gt;NuGet: &lt;a href="https://www.nuget.org/packages/OpenTelemetry.OpAmp.Client/0.5.0-alpha.1" rel="nofollow"&gt;OpenTelemetry.OpAmp.Client v0.5.0-alpha.1&lt;/a&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;
&lt;p&gt;Add support for reporting remote configuration status.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4509" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4509/hovercard"&gt;#4509&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;Expose public &lt;code&gt;ServerCapabilitiesMessage&lt;/code&gt;.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4485" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4485/hovercard"&gt;#4485&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;Serialize WebSocket writes so an outbound message no longer races the&lt;br&gt;
receiver's oversized-message close to avoid faulting the receive loop.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4532" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4532/hovercard"&gt;#4532&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;li&gt;
&lt;p&gt;Expose public &lt;code&gt;FlagsMessage&lt;/code&gt;.&lt;br&gt;
(&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/pull/4478" data-hovercard-type="pull_request" data-hovercard-url="/open-telemetry/opentelemetry-dotnet-contrib/pull/4478/hovercard"&gt;#4478&lt;/a&gt;)&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;See &lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/blob/OpAmp.Client-0.5.0-alpha.1/src/OpenTelemetry.OpAmp.Client/CHANGELOG.md"&gt;CHANGELOG&lt;/a&gt; for details.&lt;/p&gt;
&lt;/li&gt;
&lt;/ul&gt;
                            &lt;/div&gt;
                        &lt;/article&gt;
                    
                &lt;/div&gt;
