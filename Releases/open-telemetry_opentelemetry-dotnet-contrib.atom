                        &lt;/article&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/open-telemetry/opentelemetry-dotnet-contrib/releases/tag/Resources.Gcp-1.0.0-alpha.8"&gt;Resources.Gcp-1.0.0-alpha.8&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;ul&gt;
&lt;li&gt;
&lt;p&gt;NuGet: &lt;a href="https://www.nuget.org/packages/OpenTelemetry.Resources.Gcp/1.0.0-alpha.8" rel="nofollow"&gt;OpenTelemetry.Resources.Gcp v1.0.0-alpha.8&lt;/a&gt;&lt;/p&gt;
