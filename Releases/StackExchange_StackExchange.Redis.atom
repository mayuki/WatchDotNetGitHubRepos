&lt;li&gt;&lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/AbhinavMir/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/AbhinavMir"&gt;@AbhinavMir&lt;/a&gt; made their first contribution in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="5242795496" data-permission-text="Title is private" data-url="https://github.com/StackExchange/StackExchange.Redis/issues/3192" data-hovercard-type="pull_request" data-hovercard-url="/StackExchange/StackExchange.Redis/pull/3192/hovercard" href="https://github.com/StackExchange/StackExchange.Redis/pull/3192"&gt;#3192&lt;/a&gt;&lt;/li&gt;
