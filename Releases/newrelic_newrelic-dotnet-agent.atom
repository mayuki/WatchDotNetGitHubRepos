&lt;li&gt;.NET 10 Support (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3271" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3271/hovercard"&gt;#3271&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/3b03e65852475b59e3637081425c137d4f7cb914"&gt;3b03e65&lt;/a&gt;)&lt;/li&gt;
