                            &lt;h2&gt;&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/releases/tag/v10.53.1"&gt;v10.53.1&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h2&gt;&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/compare/v10.53.0...v10.53.1"&gt;10.53.1&lt;/a&gt; (2026-08-12)&lt;/h2&gt;
&lt;h3&gt;Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Add on-insert check to SimpleCache to prevent runaway growth. (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3727" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3727/hovercard"&gt;#3727&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/88e667f8d4d4c1b6cf82a228e7de67bb1a5d0d4a"&gt;88e667f&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Aggregate metrics post rename instead of using old names. (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3729" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3729/hovercard"&gt;#3729&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/67f7fcdefb67890df70e600936bed537d5b32d1a"&gt;67f7fcd&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Guard null OperationContext in WCF MethodInvokerWrapper (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3730" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3730/hovercard"&gt;#3730&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/4ab79f32c4fb6a22d92d488920894f0d069e9d28"&gt;4ab79f3&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Instrument new method for local log decoration in Serilog 4.4.0+ (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3705" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3705/hovercard"&gt;#3705&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/426f7114ced333e508e168179b28837f8d42fbe4"&gt;426f711&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Prevent double RUM script injection in ASP.NET Core 6+ responses (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3726" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3726/hovercard"&gt;#3726&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/498da9850133d8d16c2a906d6a4e9951ef39e3ac"&gt;498da98&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Report the database a SQL command actually ran against (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3752" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3752/hovercard"&gt;#3752&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/b24ff1062a728ba3809ce02feca8a80b6f12fcda"&gt;b24ff10&lt;/a&gt;)&lt;/li&gt;
