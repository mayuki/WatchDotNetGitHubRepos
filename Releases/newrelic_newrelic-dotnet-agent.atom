                                &lt;h2&gt;&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/compare/v10.49.0...v10.50.0"&gt;10.50.0&lt;/a&gt; (2026-03-17)&lt;/h2&gt;
&lt;h3&gt;New features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Add array support for custom attributes in .NET Agent API (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3456" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3456/hovercard"&gt;#3456&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/4fb9405fff5c95ed32f7d067e199add79a686de4"&gt;4fb9405&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add hybrid agent support for grpc-dotnet. (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3475" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3475/hovercard"&gt;#3475&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/6b48c06704838ee62ccf2854afa3370125c3ef3e"&gt;6b48c06&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add LLM monitoring for &lt;code&gt;Microsoft.Extensions.AI&lt;/code&gt; via OpenTelemetry bridge (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3472" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3472/hovercard"&gt;#3472&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/2e03c0c63856a0e8ee09f5b28c941eba5f24504f"&gt;2e03c0c&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Don't instrument Blazor / SignalR websocket connections (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3468" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3468/hovercard"&gt;#3468&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/7f2a5e909601310a02c823508ccd214d8cd63e12"&gt;7f2a5e9&lt;/a&gt;)&lt;/li&gt;
