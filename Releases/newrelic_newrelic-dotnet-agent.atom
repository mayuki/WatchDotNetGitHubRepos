                &lt;div&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/releases/tag/v10.52.0"&gt;v10.52.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h2&gt;&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/compare/v10.51.1...v10.52.0"&gt;10.52.0&lt;/a&gt; (2026-06-24)&lt;/h2&gt;
&lt;h3&gt;New features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Add alternative environment variables for expected and ignored error codes. (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3626" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3626/hovercard"&gt;#3626&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/c29f037c08c949a58ec2e8e83471c8025843b048"&gt;c29f037&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add Kafka internal metrics (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3555" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3555/hovercard"&gt;#3555&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/1102c0bed0e263fa044c184f6971e5832cc49a54"&gt;1102c0b&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add SQL metadata comments to enable APM to DB Query Performance Monitoring correlation (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3582" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3582/hovercard"&gt;#3582&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/04599b54f98e97f97708e9a1f53426a4c644b2ef"&gt;04599b5&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Bedrock Converse no longer drops events when first content block is non-text (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3649" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3649/hovercard"&gt;#3649&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/8813077600b61712b3d1f09d4fbb4f5310858806"&gt;8813077&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Distributed tracing for HttpWebRequest body and async requests (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3652" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3652/hovercard"&gt;#3652&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/8f8928d85b3bd5071f98c8cf28d2ff7db7fcf773"&gt;8f8928d&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Prevent malformed log_event_data JSON for non-serializable context values (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/issues/3642" data-hovercard-type="pull_request" data-hovercard-url="/newrelic/newrelic-dotnet-agent/pull/3642/hovercard"&gt;#3642&lt;/a&gt;) (&lt;a href="https://github.com/newrelic/newrelic-dotnet-agent/commit/a7108cb193a83ad2c23fbd0de80e05d0be68d617"&gt;a7108cb&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
