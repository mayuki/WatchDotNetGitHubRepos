                            &lt;h2&gt;&lt;a href="https://github.com/CommunityToolkit/Maui/releases/tag/9.0.0-mediaelement"&gt;MediaElement v9.0.0: UriMediaSource HttpHeaders&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h2&gt;&lt;code&gt;CommunityToolkit.Maui.MediaElement v9.0.0&lt;/code&gt;&lt;/h2&gt;
&lt;h2&gt;Introducing &lt;code&gt;UriMediaSource.HttpHeaders&lt;/code&gt;&lt;/h2&gt;
&lt;p&gt;We heard your feedback! You can now use Http Headers for &lt;code&gt;UriMediaSource&lt;/code&gt;:&lt;/p&gt;
&lt;div class="highlight highlight-source-cs notranslate position-relative overflow-auto" data-snippet-clipboard-copy-content="var headers = new Dictionary&amp;lt;string, string&amp;gt;
{
    [&amp;quot;Authorization&amp;quot;] = &amp;quot;Bearer my-token&amp;quot;
};
mediaElement.Source = MediaSource.FromUri(new Uri(&amp;quot;https://example.com/stream.m3u8&amp;quot;), headers);"&gt;&lt;pre&gt;&lt;span class="pl-k"&gt;var&lt;/span&gt; &lt;span class="pl-s1"&gt;headers&lt;/span&gt; &lt;span class="pl-c1"&gt;=&lt;/span&gt; &lt;span class="pl-k"&gt;new&lt;/span&gt; &lt;span class="pl-smi"&gt;Dictionary&lt;/span&gt;&lt;span class="pl-c1"&gt;&amp;lt;&lt;/span&gt;&lt;span class="pl-smi"&gt;string&lt;/span&gt;&lt;span class="pl-kos"&gt;,&lt;/span&gt; &lt;span class="pl-smi"&gt;string&lt;/span&gt;&lt;span class="pl-c1"&gt;&amp;gt;&lt;/span&gt;
&lt;span class="pl-kos"&gt;{&lt;/span&gt;
    &lt;span class="pl-kos"&gt;[&lt;/span&gt;&lt;span class="pl-s"&gt;"Authorization"&lt;/span&gt;&lt;span class="pl-kos"&gt;]&lt;/span&gt; &lt;span class="pl-c1"&gt;=&lt;/span&gt; &lt;span class="pl-s"&gt;"Bearer my-token"&lt;/span&gt;
&lt;span class="pl-kos"&gt;}&lt;/span&gt;&lt;span class="pl-kos"&gt;;&lt;/span&gt;
&lt;span class="pl-s1"&gt;mediaElement&lt;/span&gt;&lt;span class="pl-kos"&gt;.&lt;/span&gt;&lt;span class="pl-s1"&gt;Source&lt;/span&gt; &lt;span class="pl-c1"&gt;=&lt;/span&gt; &lt;span class="pl-s1"&gt;MediaSource&lt;/span&gt;&lt;span class="pl-kos"&gt;.&lt;/span&gt;&lt;span class="pl-en"&gt;FromUri&lt;/span&gt;&lt;span class="pl-kos"&gt;(&lt;/span&gt;&lt;span class="pl-k"&gt;new&lt;/span&gt; &lt;span class="pl-smi"&gt;Uri&lt;/span&gt;&lt;span class="pl-kos"&gt;(&lt;/span&gt;&lt;span class="pl-s"&gt;"https://example.com/stream.m3u8"&lt;/span&gt;&lt;span class="pl-kos"&gt;)&lt;/span&gt;&lt;span class="pl-kos"&gt;,&lt;/span&gt; &lt;span class="pl-s1"&gt;headers&lt;/span&gt;&lt;span class="pl-kos"&gt;)&lt;/span&gt;&lt;span class="pl-kos"&gt;;&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;
&lt;h2&gt;What's Changed&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Add DynamicDependency to MauiMediaElement constructors by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/ne0rrmatrix/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/ne0rrmatrix"&gt;@ne0rrmatrix&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3980658574" data-permission-text="Title is private" data-url="https://github.com/CommunityToolkit/Maui/issues/3116" data-hovercard-type="pull_request" data-hovercard-url="/CommunityToolkit/Maui/pull/3116/hovercard" href="https://github.com/CommunityToolkit/Maui/pull/3116"&gt;#3116&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;UriMediaSource HttpHeaders by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/Kaaybi/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/Kaaybi"&gt;@Kaaybi&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4109582861" data-permission-text="Title is private" data-url="https://github.com/CommunityToolkit/Maui/issues/3169" data-hovercard-type="pull_request" data-hovercard-url="/CommunityToolkit/Maui/pull/3169/hovercard" href="https://github.com/CommunityToolkit/Maui/pull/3169"&gt;#3169&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
