&lt;li&gt;Fix DateTimeOffset Converter &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="2916661887" data-permission-text="Title is private" data-url="https://github.com/CommunityToolkit/Maui/issues/2582" data-hovercard-type="issue" data-hovercard-url="/CommunityToolkit/Maui/issues/2582/hovercard" href="https://github.com/CommunityToolkit/Maui/issues/2582"&gt;#2582&lt;/a&gt; by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/VladislavAntonyuk/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/VladislavAntonyuk"&gt;@VladislavAntonyuk&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3912718225" data-permission-text="Title is private" data-url="https://github.com/CommunityToolkit/Maui/issues/3077" data-hovercard-type="pull_request" data-hovercard-url="/CommunityToolkit/Maui/pull/3077/hovercard" href="https://github.com/CommunityToolkit/Maui/pull/3077"&gt;#3077&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Bump Microsoft.Extensions.Http.Resilience from 10.2.0 to 10.3.0 by &lt;a class="user-mention notranslate" data-hovercard-type="organization" data-hovercard-url="/orgs/dependabot/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/dependabot"&gt;@dependabot&lt;/a&gt;[bot] in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3924864614" data-permission-text="Title is private" data-url="https://github.com/CommunityToolkit/Maui/issues/3086" data-hovercard-type="pull_request" data-hovercard-url="/CommunityToolkit/Maui/pull/3086/hovercard" href="https://github.com/CommunityToolkit/Maui/pull/3086"&gt;#3086&lt;/a&gt;&lt;/li&gt;
