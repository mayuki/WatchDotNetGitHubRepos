                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/autofac/Autofac/releases/tag/v9.2.0"&gt;v9.2.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h2&gt;What's Changed&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;Fix decorator parameter selection for derived-service dependencies (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3038286644" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1459" data-hovercard-type="issue" data-hovercard-url="/autofac/Autofac/issues/1459/hovercard" href="https://github.com/autofac/Autofac/issues/1459"&gt;#1459&lt;/a&gt;) by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/tillig/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/tillig"&gt;@tillig&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4668498050" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1484" data-hovercard-type="pull_request" data-hovercard-url="/autofac/Autofac/pull/1484/hovercard" href="https://github.com/autofac/Autofac/pull/1484"&gt;#1484&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Dispose container when an &lt;code&gt;IStartable&lt;/code&gt; throws during Build (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="1870987456" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1392" data-hovercard-type="issue" data-hovercard-url="/autofac/Autofac/issues/1392/hovercard" href="https://github.com/autofac/Autofac/issues/1392"&gt;#1392&lt;/a&gt;) by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/tillig/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/tillig"&gt;@tillig&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4668992310" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1485" data-hovercard-type="pull_request" data-hovercard-url="/autofac/Autofac/pull/1485/hovercard" href="https://github.com/autofac/Autofac/pull/1485"&gt;#1485&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Honor &lt;code&gt;ExternallyOwned&lt;/code&gt; ownership for decorators (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="1986125981" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1402" data-hovercard-type="issue" data-hovercard-url="/autofac/Autofac/issues/1402/hovercard" href="https://github.com/autofac/Autofac/issues/1402"&gt;#1402&lt;/a&gt;) by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/tillig/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/tillig"&gt;@tillig&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4668993152" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1486" data-hovercard-type="pull_request" data-hovercard-url="/autofac/Autofac/pull/1486/hovercard" href="https://github.com/autofac/Autofac/pull/1486"&gt;#1486&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Only subscribe &lt;code&gt;Module&lt;/code&gt; registry events when hooks are overridden (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="2850226231" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1446" data-hovercard-type="issue" data-hovercard-url="/autofac/Autofac/issues/1446/hovercard" href="https://github.com/autofac/Autofac/issues/1446"&gt;#1446&lt;/a&gt;) by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/tillig/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/tillig"&gt;@tillig&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4668993883" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1487" data-hovercard-type="pull_request" data-hovercard-url="/autofac/Autofac/pull/1487/hovercard" href="https://github.com/autofac/Autofac/pull/1487"&gt;#1487&lt;/a&gt;&lt;/li&gt;
