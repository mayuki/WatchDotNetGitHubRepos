&lt;li&gt;Fail fast when a scope-local registration binds its lifetime to an ancestor scope (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3072073104" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1460" data-hovercard-type="issue" data-hovercard-url="/autofac/Autofac/issues/1460/hovercard" href="https://github.com/autofac/Autofac/issues/1460"&gt;#1460&lt;/a&gt;) by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/tillig/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/tillig"&gt;@tillig&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4668995615" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1488" data-hovercard-type="pull_request" data-hovercard-url="/autofac/Autofac/pull/1488/hovercard" href="https://github.com/autofac/Autofac/pull/1488"&gt;#1488&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Add &lt;code&gt;GetRegistrationId&lt;/code&gt; extension to expose a registration's unique ID (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="1228077290" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1327" data-hovercard-type="issue" data-hovercard-url="/autofac/Autofac/issues/1327/hovercard" href="https://github.com/autofac/Autofac/issues/1327"&gt;#1327&lt;/a&gt;) by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/tillig/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/tillig"&gt;@tillig&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4676149835" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1490" data-hovercard-type="pull_request" data-hovercard-url="/autofac/Autofac/pull/1490/hovercard" href="https://github.com/autofac/Autofac/pull/1490"&gt;#1490&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;Cache compiled factory-delegate generators to avoid recompilation across scopes (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3199623635" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1461" data-hovercard-type="issue" data-hovercard-url="/autofac/Autofac/issues/1461/hovercard" href="https://github.com/autofac/Autofac/issues/1461"&gt;#1461&lt;/a&gt;) by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/tillig/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/tillig"&gt;@tillig&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4676232900" data-permission-text="Title is private" data-url="https://github.com/autofac/Autofac/issues/1491" data-hovercard-type="pull_request" data-hovercard-url="/autofac/Autofac/pull/1491/hovercard" href="https://github.com/autofac/Autofac/pull/1491"&gt;#1491&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
