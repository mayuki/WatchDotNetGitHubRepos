&lt;li&gt;Headless – Throw &lt;code&gt;ObjectDisposedException&lt;/code&gt; when &lt;code&gt;PlatformImpl&lt;/code&gt; is null by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/maxkatz6/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/maxkatz6"&gt;@maxkatz6&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4342107709" data-permission-text="Title is private" data-url="https://github.com/AvaloniaUI/Avalonia/issues/21276" data-hovercard-type="pull_request" data-hovercard-url="/AvaloniaUI/Avalonia/pull/21276/hovercard" href="https://github.com/AvaloniaUI/Avalonia/pull/21276"&gt;#21276&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
