&lt;li&gt;[Metal] Dispose GRBackendRenderTarget and &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/autoreleasepool/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/autoreleasepool"&gt;@autoreleasepool&lt;/a&gt; for metal objects by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/drasticactions/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/drasticactions"&gt;@drasticactions&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4029308362" data-permission-text="Title is private" data-url="https://github.com/AvaloniaUI/Avalonia/issues/20815" data-hovercard-type="pull_request" data-hovercard-url="/AvaloniaUI/Avalonia/pull/20815/hovercard" href="https://github.com/AvaloniaUI/Avalonia/pull/20815"&gt;#20815&lt;/a&gt;&lt;/li&gt;
