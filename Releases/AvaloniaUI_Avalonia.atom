&lt;li&gt;ReactiveUI – Remove &lt;code&gt;Avalonia.ReactiveUI&lt;/code&gt; by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/MrJul/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/MrJul"&gt;@MrJul&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3644043620" data-permission-text="Title is private" data-url="https://github.com/AvaloniaUI/Avalonia/issues/20101" data-hovercard-type="pull_request" data-hovercard-url="/AvaloniaUI/Avalonia/pull/20101/hovercard" href="https://github.com/AvaloniaUI/Avalonia/pull/20101"&gt;#20101&lt;/a&gt;&lt;/li&gt;
