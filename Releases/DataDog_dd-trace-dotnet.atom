&lt;li&gt;Avoid using GITHUB_TOKEN for pr creation (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3280335818" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7310" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7310/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7310"&gt;#7310&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fix octo sts trust policy subject (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3280771367" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7313" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7313/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7313"&gt;#7313&lt;/a&gt;)&lt;/li&gt;
