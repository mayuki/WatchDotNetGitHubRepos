&lt;li&gt;Allow passing fallback values to &lt;code&gt;IntegrationSettingsCollection&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3410897225" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7510" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7510/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7510"&gt;#7510&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add AGENTS.md file (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3433514112" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7539" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7539/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7539"&gt;#7539&lt;/a&gt;)&lt;/li&gt;
