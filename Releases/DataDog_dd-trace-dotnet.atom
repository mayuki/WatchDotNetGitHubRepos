                &lt;div&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/DataDog/dd-trace-dotnet/releases/tag/v3.52.0"&gt;3.52.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h2&gt;Summary&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;[Tracing] Reduce dropped traces during forced flush&lt;/li&gt;
&lt;li&gt;[Tracing] Improve runtime metrics memory_load calculation&lt;/li&gt;
&lt;li&gt;[ASM[ Various bug fixes and improvements&lt;/li&gt;
&lt;li&gt;[Code Origins] Add code-origin support for ASP.NET&lt;/li&gt;
&lt;li&gt;[Dynamic Instrumentation] Add time budgets for probe expression evaluation&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Changes&lt;/h2&gt;
&lt;h3&gt;Tracer&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Change &lt;code&gt;AgentWriter&lt;/code&gt; to only flush from a single task (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="5083308435" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/9007" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/9007/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/9007"&gt;#9007&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;code&gt;AgentWriter&lt;/code&gt; cleanup (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="5089926589" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/9010" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/9010/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/9010"&gt;#9010&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;&lt;code&gt;AgentWriter&lt;/code&gt; testing cleanup (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="5089984218" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/9011" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/9011/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/9011"&gt;#9011&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fix minor &lt;code&gt;AgentWriter&lt;/code&gt; bugs (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="5090020928" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/9013" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/9013/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/9013"&gt;#9013&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Ensure &lt;code&gt;AgentWriter&lt;/code&gt; serialization always happens on the same thread (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="5090122913" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/9014" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/9014/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/9014"&gt;#9014&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Avoid flinalizer crash on .NET Framework with &lt;code&gt;FreeConsole&lt;/code&gt;/&lt;code&gt;AllocConsole&lt;/code&gt;/&lt;code&gt;AttachConsole&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="5193135286" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/9079" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/9079/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/9079"&gt;#9079&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Partially fix runtime metrics memory_load calculation (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="5215325037" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/9095" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/9095/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/9095"&gt;#9095&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
