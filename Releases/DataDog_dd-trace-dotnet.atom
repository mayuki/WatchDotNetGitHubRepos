                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/DataDog/dd-trace-dotnet/releases/tag/v3.27.0"&gt;3.27.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h2&gt;Summary&lt;/h2&gt;
&lt;p&gt;Various bug fixes and optimizations. Includes fix for Runtime Metrics that could be missing and more accurate telemetry reporting.&lt;/p&gt;
&lt;h2&gt;Changes&lt;/h2&gt;
&lt;h3&gt;Tracer&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Remove unused dynamic settings (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3394807089" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7487" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7487/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7487"&gt;#7487&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fix incorrect usages of TracerManager PerTraceSettings (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3394828215" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7488" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7488/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7488"&gt;#7488&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add additional compiler flags to allow &lt;code&gt;required&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3405875283" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7501" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7501/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7501"&gt;#7501&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fix .NET 10 RC1 bugs (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3409666460" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7506" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7506/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7506"&gt;#7506&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;fix(telemetry): correct heartbeat interval calculation (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3410444116" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7507" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7507/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7507"&gt;#7507&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fix &lt;code&gt;ManualInstrumentationConfigSource&lt;/code&gt; and introduce base type (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3410848696" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7508" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7508/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7508"&gt;#7508&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Allow optimized creating of composite configuration source (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3410863775" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7509" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7509/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7509"&gt;#7509&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Move partial flush settings from &lt;code&gt;ExporterSettings&lt;/code&gt; to &lt;code&gt;TracerSettings&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3417264740" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7516" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7516/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7516"&gt;#7516&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;fix: change Language value from '.NET' to 'dotnet' in trace headers (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3422247309" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7523" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7523/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7523"&gt;#7523&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Hide problematic public APIs using &lt;code&gt;[EditorBrowsable]&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3429969462" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7531" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7531/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7531"&gt;#7531&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add a Continuous Profiler availability check (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3430763657" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7534" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7534/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7534"&gt;#7534&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;ASM&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;[AAP] Update waf version to v1.28.0 (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3398990096" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7494" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7494/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7494"&gt;#7494&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[AAP] Update waf to v1.28.1 (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3422433689" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7524" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7524/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7524"&gt;#7524&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[AAP] Test endpoint collection with APM tracing disabled (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3431044790" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7535" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7535/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7535"&gt;#7535&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Debugger&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;[Dynamic Instrumentation] Added native hot standby mode to support Remote Enablement and Stable Config (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3358804018" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7441" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7441/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7441"&gt;#7441&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[Dynamic Instrumentation] Avoid async instrumentation if the type &lt;code&gt;AsyncMethodDebuggerInvokerV2&lt;/code&gt; does not exist (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3414060591" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7513" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7513/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7513"&gt;#7513&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Serverless&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;[Azure Functions] bump &lt;code&gt;Datadog.Serverless.Compat&lt;/code&gt; nuget package reference (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3399625198" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7497" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7497/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7497"&gt;#7497&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;More cleanup in native loader code (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3386868756" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7475" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7475/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7475"&gt;#7475&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fix dependabot again by allowing private feed access (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3387728632" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7480" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7480/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7480"&gt;#7480&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[Tracer] Updating Statsd in RuntimeEventListener (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3413869442" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7512" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7512/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7512"&gt;#7512&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
