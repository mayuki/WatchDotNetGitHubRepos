                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/DataDog/dd-trace-dotnet/releases/tag/v3.22.0"&gt;3.22.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h2&gt;Summary&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;[Azure Functions] Support for Azure Functions is GA&lt;/li&gt;
&lt;li&gt;[Azure Functions] Optimized support for Azure Functions with the &lt;code&gt;Datadog.AzureFunctions&lt;/code&gt; NuGet package&lt;/li&gt;
&lt;li&gt;[TestOptimization] Add support for &lt;code&gt;pr.number&lt;/code&gt; and additional CI variables&lt;/li&gt;
&lt;li&gt;[TestOptimization] Add support for &lt;code&gt;xunit.v3&lt;/code&gt; version 3.x.x&lt;/li&gt;
&lt;li&gt;[Data Streams Monitoring] Initial support for the default experience&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Changes&lt;/h2&gt;
&lt;h3&gt;Tracer&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Integrations: Disable AWS Kinesis injection when the integration is disabled (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3241407754" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7239" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7239/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7239"&gt;#7239&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Refactor &lt;code&gt;SpanContextInjector&lt;/code&gt; and &lt;code&gt;SpanContextExtractor&lt;/code&gt; and improve tests (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3251898102" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7258" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7258/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7258"&gt;#7258&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;CI Visibility&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;[TestOptimization] Update the CI Environment Values parser (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3243613670" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7242" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7242/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7242"&gt;#7242&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add support for &lt;code&gt;xunit.v3&lt;/code&gt; v3 (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3247740623" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7245" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7245/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7245"&gt;#7245&lt;/a&gt;)&lt;/li&gt;
