                &lt;div&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/DataDog/dd-trace-dotnet/releases/tag/v3.35.0"&gt;3.35.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h2&gt;Summary&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;[Continuous Profiler] Fix a potential deadlock when running on Alpine&lt;/li&gt;
&lt;li&gt;[Direct Log Submission] Fix handling of Serilog custom properties&lt;/li&gt;
&lt;li&gt;[OpenTelemetry] Various performance improvements for Activity integration&lt;/li&gt;
&lt;li&gt;[Runtime Metrics] Add experimental &lt;code&gt;System.Diagnostics.Metrics&lt;/code&gt;-based runtime metrics listener&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Changes&lt;/h2&gt;
&lt;h3&gt;Tracer&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Small perf tweaks for &lt;code&gt;AspNetCoreDiagnosticObserver&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3739725545" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7963" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7963/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7963"&gt;#7963&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Stop recreating &lt;code&gt;SpanEventsManager&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3747333757" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7978" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7978/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7978"&gt;#7978&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fix nullable annotations on &lt;code&gt;Activity&lt;/code&gt; duck types (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3793234060" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8038" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8038/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8038"&gt;#8038&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Avoid allocating a closure for &lt;code&gt;ActivityMappingById.GetOrAdd&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3793249697" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8039" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8039/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8039"&gt;#8039&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Introduce &lt;code&gt;ActivityKey&lt;/code&gt; to remove string concatenation (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3793220275" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8037" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8037/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8037"&gt;#8037&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Continuous Profiler&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Add process tags to profiles (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3557057488" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7715" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7715/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7715"&gt;#7715&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[Profiler] Fix alpine deadlock 2 (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3770161786" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8021" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8021/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8021"&gt;#8021&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Debugger&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;[Dynamic Instrumentation] Fix DebuggerUploader adaptive flush interval (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3633919312" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7831" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7831/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7831"&gt;#7831&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[Dynamic Instrumentation] DEBUG-4758 Fix type mismatch with &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/duration/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/duration"&gt;@duration&lt;/a&gt; expression (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3643426596" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7844" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7844/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7844"&gt;#7844&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[EL] DEBUG-4880 Align probe expression compilation with runtime types (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3750051442" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7992" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7992/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7992"&gt;#7992&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[Dynamic Instrumentation] Disable AppDomain related log flooding on .NET Framework (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3774373207" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8025" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8025/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8025"&gt;#8025&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[SymDB] Do not send telemetry on transient http error (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3633920578" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7832" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7832/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7832"&gt;#7832&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Fixes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Fix &lt;code&gt;DuckTypeFieldIsReadonlyException&lt;/code&gt; in RabbitMQ v7+ auto-instrumentation (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3757741977" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8006" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8006/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8006"&gt;#8006&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fix Serilog direct log submission failing when writing unknown custom properties (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3758672487" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8010" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8010/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8010"&gt;#8010&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Miscellaneous&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Fix invalid telemetry when using manual config in code with dictionaries (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3770516904" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8022" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8022/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8022"&gt;#8022&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add helper methods to &lt;code&gt;IApiWebRequest&lt;/code&gt; for serializing JSON directly to a &lt;code&gt;Stream&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3769623961" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8019" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8019/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8019"&gt;#8019&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Refacto: Make ContainerMetadata an instance class (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3690633850" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7898" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7898/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7898"&gt;#7898&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Stop storing tracer setting telemetry forever (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3699576126" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7914" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7914/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7914"&gt;#7914&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add /analyze-crash and /analyze-error Claude commands (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3739498961" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7961" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7961/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7961"&gt;#7961&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add a &lt;code&gt;ValueStringBuilder&lt;/code&gt; for .NET 6 (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3739712070" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7962" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7962/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7962"&gt;#7962&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add Windows Command Line Best Practices to AGENTS.md (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3747967777" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7980" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7980/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7980"&gt;#7980&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Use &lt;code&gt;IApiRequest.PostAsJson&amp;lt;T&amp;gt;&lt;/code&gt; where possible (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3767923612" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8017" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8017/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8017"&gt;#8017&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Create &lt;code&gt;System.Diagnostics.Metrics&lt;/code&gt;-based runtime metrics listener (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3776339457" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8027" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8027/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8027"&gt;#8027&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Support custom &lt;code&gt;LogEventPropertyValue&lt;/code&gt; values in direct log submission (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3785948959" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8034" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8034/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8034"&gt;#8034&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Build / Test&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Update one-pipeline version and fix automation (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3715984703" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7941" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7941/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7941"&gt;#7941&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fix broken release scripts (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3731953811" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7953" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7953/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7953"&gt;#7953&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Improve CI resilency against connectivity errors (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3743580797" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7974" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7974/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7974"&gt;#7974&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fix OnSupportedFrameworkInSsi_CallsForwarderWithExpectedTelemetry flakiness (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3748010813" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7981" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7981/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7981"&gt;#7981&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Reorganize serverless &lt;code&gt;CODEOWNERS&lt;/code&gt; by cloud provider teams (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3748938649" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7985" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7985/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7985"&gt;#7985&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[Test Package Versions Bump] Updating package versions (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3750555806" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7995" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7995/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7995"&gt;#7995&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add arm64 smoke tests for macOS (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3753418795" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/7997" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/7997/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/7997"&gt;#7997&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Flaky tests: Debugger (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3756955089" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8000" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8000/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8000"&gt;#8000&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Flaky tests: Tracer (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3756994070" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8001" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8001/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8001"&gt;#8001&lt;/a&gt;)&lt;/li&gt;
