&lt;li&gt;Trim experimental features flags (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4664345457" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8789" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8789/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8789"&gt;#8789&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Add support for &lt;code&gt;HotChocolate&lt;/code&gt; v16.x (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4693503285" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8802" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8802/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8802"&gt;#8802&lt;/a&gt;)&lt;/li&gt;
