&lt;li&gt;clean env variables in the correct place (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4937800198" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8918" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8918/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8918"&gt;#8918&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[Tests] Skip MySQL and Npgsql tests on database timeouts (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4940452255" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8922" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8922/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8922"&gt;#8922&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Exclude EndServerAsyncAdd from WCF legacy snapshots (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4949767200" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8927" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8927/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8927"&gt;#8927&lt;/a&gt;)&lt;/li&gt;
