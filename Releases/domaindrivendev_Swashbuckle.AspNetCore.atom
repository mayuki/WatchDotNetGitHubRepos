&lt;li&gt;Do not generated response codes for empty XML by &lt;a class="user-mention notranslate" data-hovercard-type="user" data-hovercard-url="/users/Marynat/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/Marynat"&gt;@Marynat&lt;/a&gt; in &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="6137438635" data-permission-text="Title is private" data-url="https://github.com/domaindrivendev/Swashbuckle.AspNetCore/issues/4238" data-hovercard-type="pull_request" data-hovercard-url="/domaindrivendev/Swashbuckle.AspNetCore/pull/4238/hovercard" href="https://github.com/domaindrivendev/Swashbuckle.AspNetCore/pull/4238"&gt;#4238&lt;/a&gt;&lt;/li&gt;
