    <content type="html">
                &lt;div&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/googleapis/google-cloud-dotnet/releases/tag/Google.Cloud.Spanner-5.13.0-beta12"&gt;Google.Cloud.Spanner version 5.13.0-beta12&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h3&gt;New features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Instrument unary operations for BuiltInMetrics.&lt;/li&gt;
&lt;li&gt;Add support for Cloud Queues&lt;/li&gt;
&lt;/ul&gt;
                            &lt;/div&gt;
                        &lt;/article&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/googleapis/google-cloud-dotnet/releases/tag/Google.Cloud.Redis.Cluster.V1-1.10.0"&gt;Google.Cloud.Redis.Cluster.V1 version 1.10.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h3&gt;New features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Add support for Basic Auth feature to Memorystore for Redis Cluster&lt;/li&gt;
&lt;/ul&gt;
                            &lt;/div&gt;
                        &lt;/article&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/googleapis/google-cloud-dotnet/releases/tag/Google.Cloud.Datastream.V1-2.13.0"&gt;Google.Cloud.Datastream.V1 version 2.13.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h3&gt;New features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Add Spanner, Dataverse, Salesforce Marketing Cloud, ServiceNow, and Workday source configs&lt;/li&gt;
&lt;li&gt;Add BigQuery partitioning and clustering customization rules to Stream&lt;/li&gt;
&lt;li&gt;Add EventFilter for partial backfills and SQL Server SSL/DDL configs&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Documentation improvements&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Update field and message documentation across Datastream v1 resources&lt;/li&gt;
&lt;/ul&gt;
                            &lt;/div&gt;
                        &lt;/article&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/googleapis/google-cloud-dotnet/releases/tag/Google.Cloud.Dataproc.V1-5.29.0"&gt;Google.Cloud.Dataproc.V1 version 5.29.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h3&gt;New features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Add &lt;code&gt;FlexibleInstanceGroupConfig&lt;/code&gt; and &lt;code&gt;master_flexible_config&lt;/code&gt;, &lt;code&gt;worker_flexible_config&lt;/code&gt;, &lt;code&gt;secondary_worker_flexible_config&lt;/code&gt; fields to &lt;code&gt;ClusterConfig&lt;/code&gt; to support Dataproc High Obtainability (HO) mode&lt;/li&gt;
&lt;li&gt;Add &lt;code&gt;MultiZoneConfig&lt;/code&gt; and &lt;code&gt;multi_zone_config&lt;/code&gt; field to &lt;code&gt;GceClusterConfig&lt;/code&gt; to support multi-zonal clusters&lt;/li&gt;
&lt;/ul&gt;
                            &lt;/div&gt;
                        &lt;/article&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/googleapis/google-cloud-dotnet/releases/tag/Google.Cloud.ContactCenterInsights.V1-2.21.0"&gt;Google.Cloud.ContactCenterInsights.V1 version 2.21.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h3&gt;New features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Add deployment, version, and subagent metadata fields to AgentInfo&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Documentation improvements&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Mark AgentInfo.team as deprecated in favor of teams&lt;/li&gt;
&lt;/ul&gt;
                            &lt;/div&gt;
                        &lt;/article&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/googleapis/google-cloud-dotnet/releases/tag/Google.Cloud.Compute.V1-4.1.0"&gt;Google.Cloud.Compute.V1 version 4.1.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h3&gt;New features&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Update Compute Engine v1 API artifacts to revision 20261007&lt;/li&gt;
&lt;li&gt;Add COMPUTE_OPTIMIZED_H4D_3TB to Commitment.Type enum&lt;/li&gt;
&lt;/ul&gt;
                            &lt;/div&gt;
                        &lt;/article&gt;
                    
