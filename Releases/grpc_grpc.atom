    <content type="html">
                &lt;div&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/grpc/grpc/releases/tag/v1.84.2"&gt;Release v1.84.2&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;p&gt;This is release gRPC Core 1.84.2 (gimbal).&lt;/p&gt;
&lt;p&gt;For gRPC documentation, see &lt;a href="https://grpc.io/" rel="nofollow"&gt;grpc.io&lt;/a&gt;. For previous releases, see &lt;a href="https://github.com/grpc/grpc/releases"&gt;Releases&lt;/a&gt;.&lt;/p&gt;
&lt;p&gt;This release contains refinements, improvements, and bug fixes.&lt;/p&gt;
&lt;h3&gt;Python&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Fixes Denial of service in Health Watch RPC (&lt;a href="https://github.com/grpc/grpc/pull/43784" data-hovercard-type="pull_request" data-hovercard-url="/grpc/grpc/pull/43784/hovercard"&gt;#43784&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fixes Memory leak in AsyncIO client-streaming calls with interceptors (&lt;a href="https://github.com/grpc/grpc/pull/43784" data-hovercard-type="pull_request" data-hovercard-url="/grpc/grpc/pull/43784/hovercard"&gt;#43784&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Core&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;host/:authority handling: consistent authority in xDS routing/RBAC, HPACK host-&amp;gt;:authority mapping, enable map_host_header_to_authority (&lt;a href="https://github.com/grpc/grpc/pull/43798" data-hovercard-type="pull_request" data-hovercard-url="/grpc/grpc/pull/43798/hovercard"&gt;#43798&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
                            &lt;/div&gt;
                        &lt;/article&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/grpc/grpc/releases/tag/v1.85.1"&gt;Release v1.85.1&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;p&gt;This is release gRPC Core 1.85.1 (googol).&lt;/p&gt;
&lt;p&gt;For gRPC documentation, see &lt;a href="https://grpc.io/" rel="nofollow"&gt;grpc.io&lt;/a&gt;. For previous releases, see &lt;a href="https://github.com/grpc/grpc/releases"&gt;Releases&lt;/a&gt;.&lt;/p&gt;
&lt;p&gt;This release contains refinements, improvements, and bug fixes.&lt;/p&gt;
&lt;h3&gt;Python&lt;/h3&gt;
&lt;hr&gt;
&lt;ul&gt;
&lt;li&gt;Fixes Denial of service in Health Watch RPC (&lt;a href="https://github.com/grpc/grpc/pull/43783" data-hovercard-type="pull_request" data-hovercard-url="/grpc/grpc/pull/43783/hovercard"&gt;#43783&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fixes Memory leak in AsyncIO client-streaming calls with interceptors (&lt;a href="https://github.com/grpc/grpc/pull/43783" data-hovercard-type="pull_request" data-hovercard-url="/grpc/grpc/pull/43783/hovercard"&gt;#43783&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Core&lt;/h3&gt;
&lt;hr&gt;
&lt;ul&gt;
&lt;li&gt;host/:authority handling in the HPACK parser (&lt;a href="https://github.com/grpc/grpc/pull/43797" data-hovercard-type="pull_request" data-hovercard-url="/grpc/grpc/pull/43797/hovercard"&gt;#43797&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
                            &lt;/div&gt;
                        &lt;/article&gt;
                    
