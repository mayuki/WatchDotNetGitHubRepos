&lt;/ul&gt;
                            &lt;/div&gt;
                        &lt;/article&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/Azure/azure-sdk-for-net/releases/tag/Azure.AI.AgentServer.AgentFramework_1.0.0-beta.9"&gt;Azure.AI.AgentServer.AgentFramework_1.0.0-beta.9&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h2&gt;1.0.0-beta.9 (2026-03-03)&lt;/h2&gt;
