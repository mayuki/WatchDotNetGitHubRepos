                &lt;div&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/DataDog/dd-trace-dotnet/releases/tag/v3.38.0"&gt;3.38.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h2&gt;Summary&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;[Test Optimization] Add &lt;code&gt;test.final_status&lt;/code&gt; tag&lt;/li&gt;
&lt;li&gt;[Profiler] Improve thread names and IDs&lt;/li&gt;
&lt;li&gt;[Dynamic Instrumentation] Remove the 100-probe limit&lt;/li&gt;
&lt;li&gt;[Feature Flags] Update Datadog.FeatureFlags.OpenFeature .NET Framework minimum version to 4.6.2, to match OpenFeature&lt;/li&gt;
&lt;li&gt;[Tracing] Performance improvements&lt;/li&gt;
&lt;/ul&gt;
&lt;h2&gt;Changes&lt;/h2&gt;
&lt;h3&gt;Tracer&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Refactoring and improvements to &lt;code&gt;HttpHeaderHelpers&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3896335534" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8153" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8153/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8153"&gt;#8153&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Improve performance of &lt;code&gt;AspNetCoreResourceNameHelper.SimplifyRouteTemplate&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3907571830" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8170" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8170/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8170"&gt;#8170&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Improve performance of &lt;code&gt;AspNetCoreResourceNameHelper.SimplifyRoutePattern&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3916683741" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8180" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8180/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8180"&gt;#8180&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Catch FileNotFoundException when accessing assemblies (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3922385319" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8185" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8185/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8185"&gt;#8185&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;[Logging] Add tag and span information to warning log (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3926771574" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8191" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8191/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8191"&gt;#8191&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Fix broken build in Rider (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3930682081" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8195" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8195/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8195"&gt;#8195&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Remove allocations for operation name/service name versioning code (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3930725683" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8196" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8196/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8196"&gt;#8196&lt;/a&gt;)&lt;/li&gt;
&lt;li&gt;Improve performance for &lt;code&gt;UriHelpers.CleanUri&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3933113967" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8199" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8199/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8199"&gt;#8199&lt;/a&gt;)&lt;/li&gt;
