                        &lt;/article&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/Azure/azure-sdk-for-net/releases/tag/Azure.Storage.DataMovement.Files.Shares_12.2.0"&gt;Azure.Storage.DataMovement.Files.Shares_12.2.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h2&gt;12.2.0 (2025-07-21)&lt;/h2&gt;
