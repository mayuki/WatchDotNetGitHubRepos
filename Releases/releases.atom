&lt;li&gt;Add &lt;code&gt;Base64DecodingStream&lt;/code&gt; (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3968116524" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8226" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8226/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8226"&gt;#8226&lt;/a&gt;)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;CI Visibility&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Add support for latest NUnit (&lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="3996947887" data-permission-text="Title is private" data-url="https://github.com/DataDog/dd-trace-dotnet/issues/8246" data-hovercard-type="pull_request" data-hovercard-url="/DataDog/dd-trace-dotnet/pull/8246/hovercard" href="https://github.com/DataDog/dd-trace-dotnet/pull/8246"&gt;#8246&lt;/a&gt;)&lt;/li&gt;
