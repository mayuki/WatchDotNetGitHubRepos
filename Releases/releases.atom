    <content type="html">
                &lt;div&gt;
                    
                        &lt;article&gt;
                            &lt;h2&gt;&lt;a href="https://github.com/aws/aws-sdk-net/releases/tag/4.0.62.0"&gt;4.0.62.0&lt;/a&gt;&lt;/h2&gt;
                            &lt;div&gt;
                                &lt;h3&gt;4.0.62.0 (2025-08-04 21:40 UTC)&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;BedrockAgentCore (4.0.1.0)
&lt;ul&gt;
&lt;li&gt;Remove superfluous field from API&lt;/li&gt;
&lt;/ul&gt;
&lt;/li&gt;
&lt;li&gt;CodeConnections (4.0.1.0)
&lt;ul&gt;
